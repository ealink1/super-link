 	}
+
+	colorizedCache.Lock()
+	colorizedCache.entries[colorizedCache.next] = colorizedEntry{key: key, out: colorized}
+	colorizedCache.next = (colorizedCache.next + 1) % colorizedCacheSize
+	colorizedCache.Unlock()
