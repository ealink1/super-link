+// A predicate avoids requiring user themes to be comparable and preserves
+// nested overrides with independently owned state.
+func RemoveThemeOverrides(match func(fyne.Theme) bool) {
+	overrides.Range(func(obj fyne.CanvasObject, scope *overrideScope) bool {
+		if match(scope.th) {
+			overrides.Delete(obj)
+		}
+		return true
